# ══════════════════════════════════════════════════════════════
#  HONEYMOON HQ — Environment variables
#  VITE_-prefix  = beschikbaar in de frontend (publieke waarden)
#  Zonder prefix = ALLEEN server-side (Netlify Functions). Nooit in client!
# ══════════════════════════════════════════════════════════════

# ── Supabase (bron van waarheid, gedeeld tussen beide telefoons) ──
VITE_SUPABASE_URL=https://jouw-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# ── AI (server-side, via netlify/functions/claude) ──
ANTHROPIC_API_KEY=sk-ant-...

# ── Google (server-side proxy voor Places + foto's) ──
GOOGLE_PLACES_API_KEY=AIza...
# Frontend Maps-key (apart, beperkt tot je Netlify-domein in Google Cloud)
VITE_GOOGLE_MAPS_API_KEY=AIza...

# ── Weer (server-side) ──
OPENWEATHER_API_KEY=...

# ── Web Push (VAPID) — genereer met:  npx web-push generate-vapid-keys ──
VITE_VAPID_PUBLIC_KEY=B...      # publieke key mag in client
VAPID_PUBLIC_KEY=B...           # zelfde publieke key, server-side
VAPID_PRIVATE_KEY=...           # ALLEEN server-side, geheim

# ── Optioneel: wisselkoers (anders gratis Frankfurter zonder key) ──
# EXCHANGE_API_KEY=
