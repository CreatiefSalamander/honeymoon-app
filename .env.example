# ══════════════════════════════════════════════════════
# HONEYMOON APP — Vereiste omgevingsvariabelen
# Voeg deze toe in: Netlify → Site settings → Environment variables
# ══════════════════════════════════════════════════════

# ── Supabase (haal op via supabase.com → project honeymoon-hq → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://jouw-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# ── Anthropic Claude (haal op via console.anthropic.com → API Keys)
ANTHROPIC_API_KEY=sk-ant-...

# ── Google Places API (haal op via console.cloud.google.com)
# Schakel in: Places API (New), Maps JavaScript API
GOOGLE_PLACES_API_KEY=AIza...

# ── AviationStack (vluchtstatus — haal op via aviationstack.com)
# Gratis tier: 500 verzoeken/maand, voldoende voor persoonlijk gebruik
AVIATIONSTACK_KEY=jouw_key_hier

# ── OpenWeather (weersvoorspelling — haal op via openweathermap.org/api)
# Gratis tier: 1.000 verzoeken/dag
OPENWEATHER_KEY=jouw_key_hier

# ══════════════════════════════════════════════════════
# STAP-VOOR-STAP HANDLEIDING:
#
# 1. Google Places API:
#    - Ga naar console.cloud.google.com
#    - Maak een project aan of selecteer bestaand
#    - Schakel "Places API (New)" in
#    - Ga naar Credentials → Create Credentials → API Key
#    - Beperk de sleutel tot "Places API" voor veiligheid
#
# 2. AviationStack:
#    - Ga naar aviationstack.com → gratis account aanmaken
#    - Dashboard → API Access Key kopiëren
#
# 3. OpenWeather:
#    - Ga naar openweathermap.org → account aanmaken
#    - API Keys tab → kopieer de gratis key
#    - Wacht ~2u voor activatie
#
# BELANGRIJK: Zet nooit echte sleutels in dit bestand of in git!
# ══════════════════════════════════════════════════════
